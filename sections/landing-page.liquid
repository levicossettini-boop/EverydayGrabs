<script>
  (function(){
    var modes = document.querySelectorAll('.eg-landing .eg-mode-toggle button');
    modes.forEach(function(btn){
      btn.addEventListener('click', function(){
        var mode = btn.dataset.mode;
        modes.forEach(function(b){ b.classList.toggle('active', b.dataset.mode === mode); b.setAttribute('aria-selected', b.dataset.mode === mode); });
        document.querySelectorAll('.eg-landing .eg-fv-mode, .eg-landing .eg-fc-mode').forEach(function(el){
          el.classList.toggle('active', el.dataset.mode === mode);
        });
      });
    });
    var sticky = document.getElementById('eg-sticky');
    var hero = document.getElementById('hero');
    if (sticky && hero) {
      window.addEventListener('scroll', function(){
        var heroBottom = hero.getBoundingClientRect().bottom;
        sticky.classList.toggle('visible', heroBottom < 0);
      });
    }
  })();
</script>

